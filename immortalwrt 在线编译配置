在线编译地址：https://firmware-selector.immortalwrt.org/
版本：24.10.6


### LAN IP（ImmortalWrt 自己）
lan_ip_address="192.168.1.229"


### 关闭 LAN 的 DHCP（避免和主路由冲突，旁路由必须关）
# 在 config_generate 或 zzz-default-settings 里加：
uci set dhcp.lan.ignore='1'
uci commit dhcp

### 防火墙放行 5003（只允许局域网）
uci add firewall rule
uci set firewall.@rule[-1].name='Allow-5003'
uci set firewall.@rule[-1].src='lan'
uci set firewall.@rule[-1].proto='tcp'
uci set firewall.@rule[-1].dest_port='5003'
uci set firewall.@rule[-1].target='ACCEPT'
uci commit firewall
